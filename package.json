{
  "name": "law-ai-platform",
  "version": "1.1.0",
  "description": "Law.AI — Autonomous Legal Business Platform (Node.js 22 & TypeScript 5 Strict)",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc && node -e \"import('node:fs').then(fs => fs.cpSync('src/frontend', 'dist/frontend', { recursive: true }))\"",
    "build:test": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "db:seed": "tsc && node dist/database/seed.js",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/law-ai.e2e-spec.js"
  },
  "keywords": [
    "legal-ai",
    "saas",
    "crm",
    "multi-tenant",
    "mcp",
    "oab",
    "lgpd"
  ],
  "author": "Law.AI Engineering Team",
  "license": "Proprietary",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.19",
    "prisma": "^6.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
