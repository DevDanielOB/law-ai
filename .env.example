# =============================================================================
# LAW.AI — AUTONOMOUS LEGAL BUSINESS PLATFORM (.env.example)
# Nunca versione segredos reais. Copie para .env e configure em cofre seguro.
# =============================================================================

# --- Ambiente e Aplicação ---
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=replace_with_32_byte_cryptographic_secret_in_production
DATABASE_URL=postgresql://neondb_owner:npg_8bWYoG1kjTuO@ep-long-rice-b5jbvpl4-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Em produção (PostgreSQL 16 + pgvector):
# DATABASE_URL=postgresql://lawai_user:strong_password@postgres:5432/lawai_prod?schema=public
REDIS_URL=redis://localhost:6379/0

# --- IA e Modelos (AIModelProvider) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL_TRIAGE=gemini-2.5-flash
GEMINI_MODEL_DRAFTING=gemini-2.5-pro
GEMINI_MODEL_ANALYZER=gemini-flash-latest
DEFAULT_TENANT_MONTHLY_AI_BUDGET_BRL=10.00

# --- WhatsApp Business Platform Oficial (MessagingProvider) ---
# Opções: twilio_whatsapp ou whatsapp_cloud
MESSAGING_PROVIDER=twilio_whatsapp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_DEFAULT_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WEBHOOK_AUTH_ENABLED=true
PUBLIC_WEBHOOK_BASE_URL=https://seu-dominio.law.ai

WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_HMAC_SECRET=replace_with_whatsapp_hmac_secret

# --- Telefonia e Agente de Voz IA (TelephonyProvider) ---
TELEPHONY_PROVIDER=twilio_elevenlabs
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
TELEPHONY_WEBHOOK_HMAC_SECRET=replace_with_telephony_hmac_secret

# --- E-mail e Agenda (EmailProvider & CalendarProvider) ---
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REDIRECT_URI=https://app.law.ai/api/v1/oauth/google/callback

# --- Assinatura Eletrônica (ESignatureProvider: zapsign | clicksign | signdocs) ---
ESIGNATURE_PROVIDER=zapsign
ZAPSIGN_API_TOKEN=
CLICKSIGN_ACCESS_TOKEN=
SIGNDOCS_API_KEY=
ESIGNATURE_WEBHOOK_HMAC_SECRET=replace_with_esignature_hmac_secret

# --- Pagamentos e Cobrança (PaymentProvider: asaas | stripe | pagarme) ---
PAYMENT_PROVIDER=asaas
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
PAYMENT_WEBHOOK_HMAC_SECRET=replace_with_payment_hmac_secret

# --- Armazenamento de Documentos (DocumentStorageProvider) ---
STORAGE_PROVIDER=local_vault
GCS_BUCKET_NAME=law-ai-documents-prod-sa-east1
GOOGLE_APPLICATION_CREDENTIALS=

# --- Observabilidade (OpenTelemetry) ---
OTEL_SERVICE_NAME=law-ai-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
